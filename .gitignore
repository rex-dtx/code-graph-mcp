# Build artifacts
/target

# Runtime data
.code-graph/
models/

# Temp / tools
.tmp/
.gsd/

# Hidden files and directories (IDE, OS, tool configs)
.*
!.gitignore
!.npmignore
!.github/
!.claude-plugin/
!.claude-plugin/**
!claude-plugin/.mcp.json
!claude-plugin/.claude-plugin/
!claude-plugin/.claude-plugin/**

# Documentation (local only) — except contributor skills, which are version
# controlled so they can be reviewed and evolve with the code they describe.
# `docs/*` rather than `docs/`: git does not descend into an excluded DIRECTORY,
# so a `!docs/skills/` negation under `docs/` would never be reached.
docs/*
!docs/skills/
!docs/skills/**

# AI assistant config
CLAUDE.md

# npm binary (built via scripts/copy-binary.js, not committed)
bin/code-graph-mcp
bin/code-graph-mcp.exe

# Platform-specific npm binaries (built during CI)
npm/*/code-graph-mcp
npm/*/code-graph-mcp.exe

# npm artifacts
node_modules/
*.tgz

# Local test harnesses and throwaway experiments
tmp/

# Embedding benchmark venv
scripts/embedding_benchmark/.venv/

# Embedding benchmark generated artifacts (inputs/outputs, not source)
scripts/embedding_benchmark/query_set.jsonl
scripts/embedding_benchmark/results/*.json
scripts/embedding_benchmark/__pycache__/
tests/embedding_benchmark/__pycache__/

# Auto-generated session-exit paused stubs (claudemd session-end-check.sh).
# Real paused-task files (tasks/<slug>-paused.md) stay tracked.
tasks/session-end-*-paused.md
